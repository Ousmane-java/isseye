# Copiez ce fichier en .env.local et remplissez les valeurs.

# URL publique du site (en local : http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# URL de l'espace admin, sur son sous-domaine (en production : https://admin.isseye.com)
NEXT_PUBLIC_ADMIN_URL=http://admin.localhost:3000

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Propriétaire(s) de la boutique : accès complet à l'admin, même avant d'avoir créé l'équipe
# (emails séparés par des virgules). Les autres membres se gèrent dans Admin > Équipe.
ADMIN_EMAILS=

# Paiement Stripe (dashboard.stripe.com › Développeurs › Clés API, puis Webhooks)
# Sans clé en développement, le paiement est simulé pour tester le parcours.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Emails (resend.com) : domaine isseye.com à vérifier dans Resend
RESEND_API_KEY=
EMAIL_FROM="ISSEYE <bonjour@isseye.com>"

# Tâches automatiques quotidiennes (Vercel Cron) : une longue chaîne aléatoire
CRON_SECRET=
